      <string notr="true">QLabel {
    background-color: rgba(93, 37, 25, 0.45);  /* پس‌زمینه شیشه‌ای شرابی/شکلاتی تیره */
    border: 1px solid rgba(217, 136, 128, 0.35); /* مرز ملو متمایل به رز-گلد شفاف */
    border-radius: 8px;                         /* گوشه‌های نرم */
    color: #FADBD8;                             /* رنگ متن صورتی بسیار ملایم و خوانا */
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 13px;
    font-weight: bold;
