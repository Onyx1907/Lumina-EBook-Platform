   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="styleSheet">
      <string notr="true">/* استایل کلی خودِ ویجت تب */
QTabWidget::pane {
    border: 1px solid rgba(184, 134, 11, 0.2); /* حاشیه طلایی بسیار ملایم دور پنل اصلی */
    background: rgba(255, 255, 255, 0.03);     /* پس‌زمینه بسیار شفاف شیشه‌ای */
    border-radius: 12px;
    top: -1px; /* برای اینکه پنل به دکمه‌های تب بچسبد */
}

/* نوار نگهدارنده تب‌ها (Tab Bar) */
QTabBar {
    qproperty-drawBase: 0; /* حذف خط پیش‌فرض زیر تب‌ها */
    border-radius: 8px;
}

/* استایل عمومی هر کدام از دکمه‌های تب */
QTabBar::tab {
    background: rgba(40, 30, 20, 0.4);       /* قهوه‌ای تیره نیمه‌شفاف */
    color: #E0D0C0;                          /* رنگ متن استخوانی/نسکافه‌ای ملایم */
    border: 1px solid rgba(184, 134, 11, 0.15);
    padding: 8px 20px;
    margin-right: 4px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font-size: 13px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    min-width: 100px;
}

/* حالت Hover: وقتی ماوس روی تبی می‌رود */
QTabBar::tab:hover {
    background: rgba(218, 165, 32, 0.1);     /* هاله طلایی ملایم */
    color: #FFD700;                          /* متن طلایی روشن */
    border-color: rgba(184, 134, 11, 0.4);
}

/* حالت Selected: تب فعال و انتخاب‌شده */
QTabBar::tab:selected {
    background: rgba(184, 134, 11, 0.25);    /* نسکافه‌ای/طلایی مشخص‌تر */
    color: #FFFFFF;                          /* متن کاملاً سفید */
    border: 2px solid rgba(184, 134, 11, 0.8);
    border-bottom-color: transparent;        /* حذف مرز پایین تب فعال برای ادغام با بدنه */
    padding-bottom: 9px;                     /* کمی بلندتر شدن تب فعال برای حس پویایی */
}

/* جابه‌جایی تب‌های غیرفعال برای ایجاد عمق بصری */
QTabBar::tab:!selected {
    margin-top: 3px; 
}</string>
     </property>
     <property name="tabPosition">
