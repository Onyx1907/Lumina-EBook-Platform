           <property name="styleSheet">
            <string notr="true">QListWidget#shelves_listWidget {
    background-color: rgba(30, 25, 20, 0.3); /* پس‌زمینه تیره و بسیار شفاف */
    border: 1px solid rgba(184, 134, 11, 0.15);
    border-radius: 10px;
    padding: 5px;
    outline: 0;
}

/* استایل هر آیتم قفسه */
QListWidget#shelves_listWidget::item {
    background-color: rgba(255, 255, 255, 0.03);
    color: #E0D0C0;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 10px 15px;
    margin-bottom: 5px;
    font-size: 13px;
    font-weight: bold;
qproperty-alignment: 'AlignHCenter| AlignVCenter';
}

/* حالت هاور (نگه داشتن ماوس) */
QListWidget#shelves_listWidget::item:hover {
    background-color: rgba(184, 134, 11, 0.1);
    color: #FFD700;
    border: 1px solid rgba(184, 134, 11, 0.3);
}

/* حالت انتخاب شده (قفسه فعال) */
QListWidget#shelves_listWidget::item:selected {
    background-color: rgba(184, 134, 11, 0.2);
    color: #FFFFFF;
    border: 1px solid rgba(184, 134, 11, 0.8);
}

/* تنظیمات کلی اسکرول‌بار عمودی */
QListWidget#shelves_listWidget QScrollBar:vertical {
    border: none;
    background: rgba(30, 25, 20, 0.2); /* پس‌زمینه شیشه‌ای بسیار تیره */
    width: 8px;                         /* بسیار باریک و مینی‌مال */
    margin: 0px 0px 0px 0px;
    border-radius: 4px;
}

/* دستگیره اسکرول‌بار (همان بخشی که حرکت می‌کند) */
QListWidget#shelves_listWidget QScrollBar::handle:vertical {
    background: rgba(184, 134, 11, 0.4); /* طلایی تیره نیمه‌شفاف */
    min-height: 20px;
    border-radius: 4px;
}

/* حالت هاور روی دستگیره (وقتی ماوس روی آن می‌رود پررنگ‌تر می‌شود) */
QListWidget#shelves_listWidget QScrollBar::handle:vertical:hover {
    background: rgba(184, 134, 11, 0.8); /* طلایی تیره کاملاً واضح */
}

/* دکمه‌های بالا و پایین اسکرول‌بار (حذفشان می‌کنیم تا مدرن‌تر شود) */
QListWidget#shelves_listWidget QScrollBar::add-line:vertical,
QListWidget#shelves_listWidget QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

/* بخش‌های خالی بالا و پایین دستگیره */
QListWidget#shelves_listWidget QScrollBar::add-page:vertical, 
QListWidget#shelves_listWidget QScrollBar::sub-page:vertical {
    background: none;
}</string>
