  <property name="styleSheet">
   <string notr="true">/* ۱. بوم اصلی صفحه (پشت ویجت‌ها) که ویدیو زیر آن پخش می‌شود */
QWidget#scrollAreaWidgetContents {
    /* یک لایه شفاف نسکافه‌ای روشن روی ویدیو می‌کشد */
    background-color: rgba(235, 220, 203, 0.45); 
}

/* ۲. حذف کامل کادر و پس‌زمینه اسکرول‌اریا برای دیده شدن ویدیو */
QScrollArea {
    border: none;
    background-color: transparent;
}

/* ۴. استایل لیست افقی کتاب‌ها */
QListWidget {
    border: none;
    background-color: transparent;
}


/* ۷. استایل دکمه خاصِ &quot;مشاهده همه&quot; در انتهای لیست */
QWidget#ViewAllCard_Widget {
    background-color: rgba(74, 46, 27, 0.15); /* تم قهوه‌ای بسیار ملایم */
    border: 2px dashed rgba(74, 46, 27, 0.4); /* خط‌چین کلاسیک */
    border-radius: 8px;
}

QWidget#ViewAllCard_Widget:hover {
    background-color: rgba(74, 46, 27, 0.3);
    cursor: pointing;
}

QLabel {
    color: #4A2E1B;
    font-weight: bold;
    font-size: 13px;
}

</string>
