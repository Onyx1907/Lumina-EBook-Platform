   <property name="styleSheet">
    <string notr="true">QPushButton {
    /* موکا/نسکافه‌ای با گرادیان نرم */
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(176, 124, 78, 245),   /* latte-mocha */
        stop:1 rgba(128, 84, 52, 245)     /* deeper nescafe */
    );

    color: rgba(255, 250, 242, 245);      /* کرمِ نزدیک به شیر */
    border: 1px solid rgba(86, 52, 28, 180);
    border-radius: 16px;

    padding: 12px 26px;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.4px;

    /* حس “قابل کلیک بودن” با border نرم */
}

QPushButton:hover:enabled {
    /* کاراملی‌تر و روشن‌تر */
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(198, 146, 92, 255),
        stop:1 rgba(148, 98, 60, 255)
    );

    border: 1px solid rgba(212, 163, 89, 170);  /* رگه‌ی طلایی خیلی ظریف */
    color: rgba(255, 253, 248, 255);
}

QPushButton:pressed:enabled {
    /* فرو رفتن: تیره‌تر + حس فشرده شدن */
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(118, 76, 46, 255),
        stop:1 rgba(96, 60, 36, 255)
    );

    border: 1px solid rgba(60, 35, 18, 200);

    /* ترفند ساده برای حس pressed */
    padding-top: 13px;
    padding-bottom: 11px;
}

QPushButton:disabled {
    /* شیشه‌ای و کم‌رنگ که مزاحم نشه */
    background: rgba(170, 150, 135, 70);
    color: rgba(255, 255, 255, 120);
    border: 1px solid rgba(120, 100, 90, 70);
}</string>
   </property>
   <property name="text">
    <string>بررسی</string>
   </property>
  </widget>
