   <property name="text">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;به کتابخونه جادویی خودت خوش اومدی&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;برای تجربه بهتر اول ژانر های مورد علاقه خودت رو انتخاب کن&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;(بین ۱ تا ۳ انتخاب)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="alignment">
    <set>Qt::AlignCenter</set>
   </property>
  </widget>
  <widget class="QPushButton" name="biography_pushButton">
   <property name="geometry">
    <rect>
     <x>130</x>
     <y>130</y>
     <width>141</width>
     <height>141</height>
    </rect>
   </property>
   <property name="styleSheet">
    <string notr="true">/* -------------------------------------------------------------
   استایل دکمه‌های ژانر (تم جادویی و کلاسیک روشن)
------------------------------------------------------------- */
QPushButton {
    /* پس‌زمینه سفید شیری ملایم و نیمه‌شفاف (برای دیده شدن آیکون‌ها) */
    background-color: rgba(255, 255, 255, 0.75); 
    
    /* لبه‌های ظریف شکلاتی-کرمی برای وایب قدیمی */
    border: 1px solid rgba(139, 90, 43, 0.25);
    border-radius: 12px;
    
    /* رنگ متن شکلاتی تیره */
    color: #4a2f15;
    font-family: &quot;Segoe UI&quot;, &quot;Georgia&quot;, &quot;Vazirmatn&quot;;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 16px;
    
    /* فاصله مناسب برای آیکون و متن */
    text-align: center;
}

/* 🌟 حالت ماوس روی دکمه (Hover) */
QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(212, 163, 89, 0.6);
    /* یک هاله بسیار خفیف طلایی در هاور */
    color: #8b5a2b;
}

/* ⚡ حالت انتخاب شده (Checked) -&gt; افکت درخشش و پس‌زمینه طلایی */
QPushButton:checked {
    /* پس‌زمینه طلایی ملایم و شفاف */
    background-color: rgba(254, 241, 203, 0.9);
    
    /* مرز دکمه با رنگ طلایی درخشان */
    border: 1.5px solid rgba(244, 180, 26, 0.85);
    color: #b0720b; /* متن کاراملی تیره و گرم */
}

/* 🌟 درخشش قوی‌تر در حالت انتخاب شده وقتی ماوس روی آن می‌رود */
QPushButton:checked:hover {
    background-color: rgba(254, 235, 180, 0.95);
    border: 1.5px solid rgba(255, 200, 50, 1);
}

/* ❌ حالت غیرفعال (اگر تعداد انتخاب‌ها بیش از ۳ شد و دکمه‌های دیگر غیرفعال شدند) */
QPushButton:disabled {
    background-color: rgba(240, 240, 240, 0.4);
    border: 1.5px solid rgba(200, 200, 200, 0.3);
    color: rgba(130, 130, 130, 0.6);
}</string>
   </property>
   <property name="text">
    <string/>
   </property>
   <property name="icon">
    <iconset resource="../resources.qrc">
