     <width>150</width>
     <height>150</height>
    </size>
   </property>
   <property name="checkable">
    <bool>true</bool>
   </property>
   <attribute name="buttonGroup">
    <string notr="true">genres_buttonGroup</string>
   </attribute>
  </widget>
