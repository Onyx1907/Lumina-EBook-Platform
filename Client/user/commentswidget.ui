   <item>
    <widget class="QListWidget" name="listWidget">
     <property name="styleSheet">
      <string notr="true">/* کاملاً شفاف کردن پس‌زمینه و حذف مرزهای لیست اصلی */
QListWidget {
    background-color: transparent;
    background: transparent;
    border: none;
    outline: none;
    padding: 10px;
}


QListWidget::item:selected {
    background-color: rgba(139, 90, 43, 0.7);
    border: 1px solid #D2B48C;
}
/* اسکرول‌بار شیشه‌ای و هماهنگ */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgba(111, 78, 55, 0.6); /* دستگیره قهوه‌ای نیمه شفاف */
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(139, 90, 43, 0.8);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none; /* حذف دکمه‌های بالا و پایین اسکرول */
}</string>
     </property>
