          <property name="styleSheet">
           <string notr="true">QSpinBox {
    padding-right: 25px; /* فضا برای دکمه‌های بالا و پایین */
    padding-left: 10px;
    border: 2px solid #C2A383; /* قهوه‌ای کاراملی روشن */
    border-radius: 6px;
    background-color: #FAF6F0; /* سفید خامه‌ای/کفِ شیر */
    color: #4A3B32; /* قهوه‌ای تیره مدیوم (خوانایی بالا) */
    font-size: 17px;
    font-weight: bold;
    selection-background-color: #DAC0A3; /* رنگ انتخاب متن */
    selection-color: #4A3B32;
}

/* حالت هاور کل باکس */
QSpinBox:hover {
    border: 2px solid #8B5E3C; /* قهوه‌ای نسکافه‌ای گرم */
}

/* حالت فوکوس روی باکس */
QSpinBox:focus {
    border: 2px solid #5C4033; /* اسپرسو تیره */
    background-color: #FFFFFF;
}

/* تنظیمات کلی دکمه‌های کنترل */
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    background-color: #EADBC8; /* رنگ نسکافه‌ای روشن */
    border-left: 2px solid #C2A383;
}

/* دکمه بالا */
QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 4px;
    border-bottom: 1px solid #C2A383;
}

/* دکمه پایین */
QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 4px;
    border-top: 1px solid #C2A383;
}

/* استایل دکمه‌ها در حالت Hover */
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #DAC0A3; /* کاراملی تیره تر */
}

/* استایل دکمه‌ها در حالت کلیک (Pressed) */
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background-color: #C2A383;
}

/* فلش‌های داخل دکمه‌ها */
QSpinBox::up-arrow {
    image: url(no_image.png); /* غیرفعال کردن تصویر پیش‌فرض سیستم */
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #4A3B32; /* فلش قهوه‌ای رو به بالا */
    width: 0;
    height: 0;
}

QSpinBox::down-arrow {
    image: url(no_image.png);
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #4A3B32; /* فلش قهوه‌ای رو به پایین */
    width: 0;
    height: 0;
}</string>
          </property>
