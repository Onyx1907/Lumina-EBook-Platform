      <item>
       <widget class="QTextEdit" name="comment_textEdit">
        <property name="styleSheet">
         <string notr="true">QTextEdit {
    background-color: rgba(255, 255, 255, 0.85); /* سفید استخوانی نیمه شفاف برای خوانایی عالی متن */
    color: #4A3B32; /* اسپرسو تیره برای متن */
    border: 1.5px solid #E0D5C1; /* مرز نسکافه‌ای کمرنگ */
    border-radius: 8px;
    padding: 8px;
    font-family: &quot;Segoe UI&quot;, Tahoma, Arial;
    font-size: 17px;
    selection-background-color: #DAC0A3;
    selection-color: #4A3B32;
}

QTextEdit:hover {
    border: 1.5px solid #C2A383; /* تغییر مرز به کاراملی هنگام هاور */
}

QTextEdit:focus {
    border: 2px solid #8B5E3C; /* اسپرسو مدیوم زمان تایپ کردن */
    background-color: #FFFFFF; /* کاملاً سفید و شفاف در زمان فوکوس برای تمرکز بهتر کاربر */
}

/* استایل اسکرول‌بار داخل تکست‌ادیت (بسیار مهم برای زیبایی کار) */
QTextEdit QScrollBar:vertical {
    border: none;
    background: #FAF6F0;
    width: 10px;
    margin: 0px 0px 0px 0px;
    border-radius: 5px;
}

QTextEdit QScrollBar::handle:vertical {
    background: #C2A383;
    min-height: 20px;
    border-radius: 5px;
}

QTextEdit QScrollBar::handle:vertical:hover {
    background: #8B5E3C;
}</string>
        </property>
       </widget>
      </item>
