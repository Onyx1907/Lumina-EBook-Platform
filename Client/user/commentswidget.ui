  <property name="styleSheet">
   <string notr="true">QFrame#write_frame {
    background-color: rgba(250, 246, 240, 0.75); /* ۷۵ درصد شفافیت نسکافه‌ای فوق‌العاده ملایم */
    border: 1px solid rgba(194, 163, 131, 0.4);  /* کادر با ۴۰ درصد شفافیت برای محو شدن مرزها */
    border-radius: 12px;
    padding: 10px;
}

/* لایبل عنوان بالای فریم */
QLabel#title_label {
    color: #6F4E37; /* قهوه‌ای سوخته لاته */
    font-weight: bold;
    font-size: 13px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
}

</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_2">
   <item>
    <widget class="QPushButton" name="back_pushButton">
     <property name="styleSheet">
      <string notr="true">QPushButton {
    background-color: rgba(255, 255, 255, 0.08); /* پس‌زمینه شیشه‌ای بسیار ملو */
    border: 1px solid rgba(193, 154, 107, 0.25); /* مرز کاراملی شفاف */
    border-radius: 8px; /* گوشه‌های نرم کلاسیک */
    color: #D2B48C; /* رنگ متنی خامه ای/نسکافه‌ای روشن */
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    padding: 6px 14px;
    min-height: 24px;
}

/* حالت Hover (وقتی موس روی دکمه می‌رود) */
QPushButton:hover {
    background-color: rgba(139, 90, 43, 0.35); /* شیشه کاراملی غلیظ‌تر */
    border: 1px solid #C19A6B; /* لبه طلایی خامه ای */
    color: #FFF; /* متن کاملا سفید و درخشان */
}

/* حالت Pressed (وقتی روی دکمه کلیک می‌شود) */
QPushButton:pressed {
    background-color: rgba(111, 78, 55, 0.6); /* رنگ قهوه‌ای تیره فشرده شده */
    border: 1px solid #8B5A2B;
    padding-left: 16px; /* افکت کلیک کوچک ملو (متمایل شدن متن به راست) */
}</string>
