  <widget class="QLineEdit" name="title_lineEdit">
   <property name="geometry">
    <rect>
     <x>180</x>
     <y>40</y>
     <width>521</width>
     <height>41</height>
    </rect>
   </property>
   <property name="styleSheet">
    <string notr="true">QLineEdit {
    background-color: rgba(255, 255, 255, 190); /* پس‌زمینه سفید-کرمی نرم */
    color: #2d1f10; /* رنگ متن قهوه‌ای تیره */
    border: 1px solid #b3a394;
    border-radius: 6px; /* لبه‌های کمی تیزتر برای حس قدیمی بودن */
    padding: 8px;
    font-size: 14px;
}

/* وقتی کاربر روی فیلد کلیک می‌کند (فوکوس) */
QLineEdit:focus {
    border: 2px solid #8c6239; /* مرز قهوه‌ای طلایی گرم */
    background-color: #ffffff;
}</string>
   </property>
   <property name="placeholderText">
    <string>عنوان کتاب</string>
   </property>
  </widget>
