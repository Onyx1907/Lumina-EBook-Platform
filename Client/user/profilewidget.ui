   <property name="styleSheet">
    <string notr="true">QFrame {
    border: none;
    /* این پالت از رنگ‌های &quot;خاکی-کرم&quot; تشکیل شده که با نورِ گرمِ محیط بهتر ترکیب میشه */
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0   rgba(170, 155, 135, 0),    /* شروع محو و شفاف */
        stop: 0.2 rgba(170, 155, 135, 100),  /* خاکستری-قهوه‌ای ملایم */
        stop: 0.5 rgba(240, 230, 210, 220),  /* مرکز روشنِ گرم (کاهی) */
        stop: 0.8 rgba(170, 155, 135, 100),  /* خاکستری-قهوه‌ای ملایم */
        stop: 1   rgba(170, 155, 135, 0)     /* پایان محو */
    );
}</string>
   </property>
   <property name="orientation">
    <enum>Qt::Horizontal</enum>
   </property>
  </widget>
