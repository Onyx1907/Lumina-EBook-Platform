  <property name="styleSheet">
   <string notr="true">/* کل صفحه ریدر */
BookReaderWidget {
    background-color: #FDFBF7; /* پس‌زمینه کرم خیلی روشن (حس کاغذ قدیمی) */
}

/* نوار ابزار بالای صفحه */
QWidget#horizontalLayoutWidget, QHBoxLayout {
    background-color: #F4ECE1; /* نسکافه‌ای روشن */
    border-bottom: 2px solid #D7C4B7;
font-size: 20px;
}

/* استایل عمومی دکمه‌های کنترلی */
QPushButton {
    background-color: #E6D5C3; /* نسکافه‌ای مدیوم */
    color: #4A3525; /* قهوه‌ای سوخته برای متن */
    border: 1px solid #C5B09E;
    border-radius: 6px;
    padding: 6px 14px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 13px;
    font-weight: bold;
}

/* افکت رفتن موس روی دکمه‌ها */
QPushButton:hover {
    background-color: #D7C4B7; /* کمی تیره تر */
    border: 1px solid #A89280;
}

/* افکت کلیک شدن دکمه‌ها */
QPushButton:pressed {
    background-color: #BD9E87; /* قهوه‌ای مایل به نسکافه‌ای تیره */
    color: #FFFFFF;
}

/* استایل کادر وارد کردن شماره صفحه */
QLineEdit {
    background-color: #FFFFFF;
    color: #4A3525;
    border: 2px solid #D7C4B7;
    border-radius: 6px;
    padding: 4px;
    font-weight: bold;
    alignment: center;
}

QLineEdit:focus {
    border: 2px solid #8C6239; /* فوکوس قهوه‌ای کلاسیک */
}

/* استایل لیبل نمایش کل صفحات */
QLabel {
    color: #5C4033; /* قهوه‌ای تاریک */
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 14px;
    font-weight: bold;
}

/* ======================================================== */
/*  تنظیمات اسکرول‌بار اختصاصی QPdfView (تم قهوه‌ای/نسکافه‌ای)  */
/* ======================================================== */

/* اسکرول‌بار عمودی */
QScrollBar:vertical {
    background-color: #F4ECE1;
    width: 14px;
    margin: 15px 3px 15px 3px;
    border: 1px solid #D7C4B7;
    border-radius: 4px;
}

/* دستگیره اسکرول‌بار عمودی */
QScrollBar::handle:vertical {
    background-color: #8C6239; /* قهوه‌ای کلاسیک */
    min-height: 25px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6F4E27; /* قهوه‌ای تیره تر هنگام هوور */
}

/* اسکرول‌بار افقی */
QScrollBar:horizontal {
    background-color: #F4ECE1;
    height: 14px;
    margin: 3px 15px 3px 15px;
    border: 1px solid #D7C4B7;
    border-radius: 4px;
}

/* دستگیره اسکرول‌بار افقی */
QScrollBar::handle:horizontal {
    background-color: #8C6239;
    min-width: 25px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6F4E27;
}

/* حذف دکمه‌های پیکان بالا و پایین اسکرول‌بار برای خلوت شدن دیزاین */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical,
QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal {
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}</string>
