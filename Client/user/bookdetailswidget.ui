       <property name="styleSheet">
        <string notr="true">/* وضعیت عادی دکمه: کاملاً بدون پس‌زمینه و فریم */
QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 20px;
    padding: 5px;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
}

/* وضعیت هاور: ایجاد یک هاله نوری ملایم و درخشش گرم در پس‌زمینه */
QPushButton:hover {
    background-color: rgba(255, 250, 240, 60); /* بک‌گراند بسیار ملایم کرم/سفید */
    border: 1px solid rgba(240, 200, 150, 120); /* مرز درخشان مسی/طلایی خفیف */
}

/* وضعیت کلیک: درخشش شدیدتر و حالت فشرده شدن */
QPushButton:pressed {
    background-color: rgba(255, 250, 240, 110);
    border: 1px solid rgba(240, 200, 150, 200);
}</string>
