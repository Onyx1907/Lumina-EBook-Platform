      <property name="styleSheet">
       <string notr="true">/* ۱. بوم اصلی صفحه (پشت ویجت‌ها) که ویدیو زیر آن پخش می‌شود */
QWidget#scrollAreaWidgetContents {
    /* یک لایه شفاف نسکافه‌ای روشن روی ویدیو می‌کشد */
    background-color: rgba(235, 220, 203, 0.45); 
}

/* ۲. حذف کامل کادر و پس‌زمینه اسکرول‌اریا برای دیده شدن ویدیو */
QScrollArea {
    border: none;
    background-color: transparent;
}

QListWidget {
    background-color: rgba(245, 230, 211, 0.65); /* ۶۵ درصد کدر، بقیه شفاف برای دیدن بک‌گراند */
    border: 2px solid rgba(111, 78, 55, 0.8); /* حاشیه قهوه‌ای با کمی شفافیت */
    border-radius: 10px;
    padding: 5px;
}

QLabel {
    background: transparent;      /* حذف کامل پس‌زمینه */
    background-color: transparent; /* اطمینان از نبود هیچ رنگی */
    border: none;                 /* اطمینان از نبود کادر */
    color: #4A3728;               /* رنگ متن رو اینجا تنظیم کن */
    margin: 0px;                  /* اطمینان از نبود فاصله اضافه */
    padding: 0px;                 /* اطمینان از نبود پدینگ اضافه */
qproperty-alignment: 'AlignRight | AlignVCenter';

}

</string>
      </property>
