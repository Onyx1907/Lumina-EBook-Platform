       <property name="styleSheet">
        <string notr="true">
QPushButton {
    background: none;
    background-color: transparent;

    border: 1px solid transparent;
    background-color: rgba(255, 248, 235, 8);
    border: 1px solid rgba(255, 228, 190, 28);
    border-radius: 10px;
    padding: 4px;
    margin: 2px;
}

QPushButton:disabled {
    color: rgba(255, 245, 230, 90);
    background-color: rgba(255, 248, 235, 8);
    border: 1px solid rgba(255, 228, 190, 28);
}

QPushButton[active=&quot;true&quot;] {
    background-color: rgba(255, 236, 200, 42);
    border: 1px solid rgba(255, 223, 170, 90);
    border-radius: 10px;
    padding: 4px;
    margin: 2px;
}</string>
