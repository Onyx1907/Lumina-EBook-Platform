     <property name="styleSheet">
      <string notr="true">/* ۱. استایل فریم اصلی (کارت شیشه‌ای نسکافه‌ای) */
QFrame#main_frame {
    background-color: rgba(30, 25, 20, 0.4); /* پس‌زمینه تیره و بسیار ملایم نسکافه‌ای */
    border: 1px solid rgba(193, 154, 107, 0.18); /* مرز نسکافه‌ای شفاف */
    border-radius: 14px; /* لبه‌های کاملاً نرم و مدرن */
}

/* ۲. نام کاربری (@username) */
QLabel#username_label {
    color: #D2B48C; /* رنگ کرم خامه‌ای جذاب */
    font-weight: bold;
    font-size: 13px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
}

/* ۳. ریتینگ (ستاره‌ها) */
QLabel#rating_label {
    color: #FFD700; /* رنگ طلایی درخشان برای ستاره‌ها */
    font-weight: bold;
    font-size: 12px;
}

/* ۴. متن اصلی کامنت */
QLabel#text_label {
    color: #E6D7C3; /* نسکافه‌ای روشن برای خوانایی عالی در تاریکی */
    font-size: 13px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    padding: 4px 2px;
}

/* ۵. تاریخ ثبت نظر */
QLabel#date_label {
    color: rgba(230, 215, 195, 0.45); /* رنگ خاکستری-کرم بسیار ملایم */
    font-size: 11px;
}

/* ۶. استایل عمومی دکمه‌های آیکون‌دار (ویرایش و حذف) */
QPushButton#edit_pushButton, QPushButton#delete_pushButton {
    background-color: rgba(255, 255, 255, 0.03); /* شیشه‌ای خنثی */
    border: 1px solid rgba(193, 154, 107, 0.15);
    border-radius: 8px;
    padding: 5px; /* فضای کافی دور آیکون */
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
}

/* ۷. حالت هاور دکمه ویرایش (تم نسکافه‌ای فعال) */
QPushButton#edit_pushButton:hover {
    background-color: rgba(193, 154, 107, 0.25);
    border-color: #C19A6B;
}

QPushButton#edit_pushButton:pressed {
    background-color: rgba(193, 154, 107, 0.4);
}

/* ۸. حالت هاور دکمه حذف (تم قرمز ملو هشداری) */
QPushButton#delete_pushButton:hover {
    background-color: rgba(231, 76, 60, 0.18); /* قرمز شیشه‌ای ملایم */
    border-color: #E74C3C;
}

QPushButton#delete_pushButton:pressed {
    background-color: rgba(231, 76, 60, 0.3);
}</string>
     </property>
