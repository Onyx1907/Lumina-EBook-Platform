     <property name="styleSheet">
      <string notr="true">/* استایل کلی فریم فاکتور (شیشه‌ای و نیمه‌شفاف برای دیدن ویدیو) */
QFrame#invoice_frame {
    /* رنگ کرم-نسکافه‌ای با شفافیت ۴۰ درصد */
    background-color: rgba(252, 250, 247, 0.4); 
    
    /* مرز نسکافه‌ای ظریف با شفافیت ۶۰ درصد */
    border: 1px solid rgba(217, 205, 184, 0.6); 
    
    border-radius: 12px;
    padding: 15px;
}

/* استایل تایتل اصلی فاکتور خرید */
QLabel#title_label {
    font-size: 18px;
    font-weight: bold;
    color: #3E2723; /* قهوه‌ای تیره با کنتراست بالا روی شیشه */
    border-bottom: 2px solid rgba(239, 234, 226, 0.5); /* خط نیمه‌شفاف زیر تایتل */
    padding-bottom: 10px;
    margin-bottom: 8px;
}

/* عناوین ثابت فاکتور (label, label_2, label_3, label_4) */
QFrame#invoice_frame QLabel#label,
QFrame#invoice_frame QLabel#label_2,
QFrame#invoice_frame QLabel#label_3,
QFrame#invoice_frame QLabel#label_4 {
    font-size: 14px;
    font-weight: bold;
    color: #3E2723; /* تیره کردن رنگ برای خوانایی عالی روی پس‌زمینه متحرک */
    background: transparent;
}

/* مقادیر عددی پویا (تعداد، قیمت کل، تخفیف) */
QLabel#count_label, 
QLabel#total_price_label, 
QLabel#discount_label {
    font-size: 16px;
    font-weight: bold;
    color: #5D4037; /* قهوه‌ای کلاسیک پررنگ */
}

/* متمایز کردن رنگ تخفیف */
QLabel#discount_label {
    color: #A0522D; /* برنزی آجری مایل به سفالی برای تمایز */
}

/* خط جداکننده افقی */
QFrame#line {
    background-color: rgba(239, 234, 226, 0.5);
    max-height: 1px;
    border: none;
}

/* مبلغ نهایی قابل پرداخت (بخش اصلی فاکتور) */
QLabel#final_price_label {
    font-size: 21px;
    font-weight: bold;
    color: #3E2723; /* بسیار تیره و خوانا */
}

/* دکمه نهایی‌سازی پرداخت (توپر با رنگ نسکافه‌ای گرم برای کنتراست عالی با شیشه) */
QPushButton#pay_pushButton {
    background-color: #8D6E63; 
    color: #FCFAF7;
    font-size: 15px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
    padding: 12px;
    min-height: 22px;
}

/* افکت رفتن موس روی دکمه (Hover) */
QPushButton#pay_pushButton:hover {
    background-color: #7D5245; 
}

/* افکت کلیک دکمه (Pressed) */
QPushButton#pay_pushButton:pressed {
    background-color: #5D4037;
}</string>
