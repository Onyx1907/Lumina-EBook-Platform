        <widget class="QPushButton" name="books_pushButton">
         <property name="styleSheet">
          <string notr="true">
QPushButton {
    background-color: rgba(139, 90, 43, 0.35); /* شیشه کاراملی غلیظ */
    border: 1px solid #C19A6B; /* لبه طلایی خامه‌ای */
    border-radius: 8px; /* گوشه‌های نرم کلاسیک */
    color: #FFF; /* متن کاملا سفید و درخشان */
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    padding: 6px 14px;
    min-height: 24px;
}

/* حالت Hover (وقتی موس روی دکمه می‌رود: غلیظ‌تر، تیره تر و کاملا مشخص) */
QPushButton:hover {
    background-color: rgba(93, 58, 25, 0.65); /* قهوه‌ای نسکافه‌ای تیره و غلیظ */
    border: 1px solid #8B5A2B; /* مرز قهوه‌ای سوخته */
    color: #F7DC6F; /* تغییر رنگ متن به طلایی درخشان برای افکت جذاب‌تر */
}

/* حالت Pressed (وقتی روی دکمه کلیک می‌شود: تاریک‌ترین و فشرده‌ترین حالت) */
QPushButton:pressed {
    background-color: rgba(54, 33, 13, 0.85); /* قهوه‌ای اسپرسو بسیار تیره و سنگین */
    border: 1px solid #4A2E14;
    padding-left: 16px; /* همان افکت کلیک ملو و قشنگ شما */
}</string>
