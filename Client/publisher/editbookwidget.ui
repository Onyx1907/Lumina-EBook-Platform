}

QComboBox:hover {
    border: 2px solid #A67C52;
}

QComboBox:focus {
    border: 2px solid #6B4F3A;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
}

QComboBox QAbstractItemView {
    background: #F8F1E7;
    color: #4A3425;
    border: 1px solid #8B6B4A;
    selection-background-color: #B08968;
    selection-color: white;
    outline: 0;
}</string>
