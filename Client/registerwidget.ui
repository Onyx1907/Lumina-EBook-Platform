     <widget class="QComboBox" name="role_comboBox">
      <property name="geometry">
       <rect>
        <x>20</x>
        <y>330</y>
        <width>121</width>
        <height>41</height>
       </rect>
      </property>
      <property name="layoutDirection">
       <enum>Qt::RightToLeft</enum>
      </property>
      <property name="styleSheet">
       <string notr="true">QComboBox {
    background-color: rgba(255, 255, 255, 190); /* پس‌زمینه کرمی نرم */
    color: #2d1f10; /* رنگ متن قهوه‌ای تیره */
    border: 1px solid #b3a394;
    font-family: &quot;Georgia&quot;, &quot;serif&quot;, &quot;B Nazanin&quot;; 
    border-radius: 4px;
    padding: 6px 12px 6px 6px;
    font-size: 14px;
    /* برای اینکه در سیستم‌عامل‌های مختلف ظاهر بومی حذف شود */
    combobox-popup: 0; 
}

/* وقتی کاربر روی کمبوباکس کلیک می‌کند */
QComboBox:focus {
    border: 2px solid #8c6239; /* مرز قهوه‌ای طلایی */
}

/* استایل دکمه‌ی فلش سمت راست کمبوباکس */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #b3a394;
    border-left-style: solid;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* ظاهر خودِ منوی بازشو (لیست گزینه‌ها) */
QComboBox QAbstractItemView {
    background-color: #f7f1e3; /* رنگ کاغذ کرمی کلاسیک */
    border: 1px solid #8c7e6d;
    selection-background-color: #5c4033; /* رنگ هاور گزینه‌ها (قهوه‌ای شکلاتی) */
    selection-color: #f7f1e3; /* رنگ متنِ گزینه انتخاب شده */
    color: #2d1f10;
    padding: 4px;
}</string>
