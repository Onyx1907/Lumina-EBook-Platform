      <property name="styleSheet">
       <string notr="true">QPushButton {
    background-color: #5c4033; /* قهوه‌ای شکلاتی تیره */
    color: #f7f1e3; /* متن کرمی روشن */
    font-weight: bold;
    font-size: 15px;
    border: 1px solid #4a3225;
    border-radius: 6px;
    font-family: &quot;Georgia&quot;, &quot;serif&quot;, &quot;B Nazanin&quot;;
    padding: 8px;
}

QPushButton:hover {
    background-color: #73503f; /* کمی روشن‌تر شدن قهوه‌ای */
}

/* وقتی دکمه فشرده می‌شود */
QPushButton:pressed {
    background-color: #4a3225;
}</string>
