         <widget class="QCheckBox" name="block_checkBox">
          <property name="styleSheet">
           <string notr="true">QCheckBox {
    color: rgb(214, 195, 170);
    font: 10pt &quot;Vazirmatn&quot;;
    border: none;
    background: transparent;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #7A5C45;
    border-radius: 5px;
    background: #FFF8EE;
}

QCheckBox::indicator:hover {
    border-color: #9A775B;
}

QCheckBox::indicator:checked {
    background: #6F4E37;
    border: 2px solid #5A3F2C;
    image: url(://resources/check.svg);
}

QCheckBox::indicator:pressed {
    background: #5A3F2C;
}

QCheckBox::indicator:unchecked:hover {
    background-color: #E8D7BF;
    border: 2px solid #8A6548;
}

QCheckBox::indicator:checked:hover {
    background-color: #7B5740;
    border: 2px solid #A57C5A;
    image: url(://resources/check.svg);
}</string>
          </property>
