    <property name="styleSheet">
     <string notr="true">QWidget#sidebar_widget {
    /* رنگ کرمی ملایم با شفافیت برای دیده شدن ویدیو */
    background-color: rgba(247, 241, 227, 0.8); 
    border: 2px solid #8c7e6d; /* مرز قهوه‌ای مات و کلاسیک */
	border-top-left-radius: 13px;
	border-bottom-left-radius: 13px;
}

/* استایل لایبل‌ها یا عناوین متنی داخل باکس */
QLabel {
    color: #4a3728; /* قهوه‌ای سوخته */
    font-family: &quot;Georgia&quot;, &quot;serif&quot;, &quot;B Nazanin&quot;; /* فونت کلاسیک */
    font-weight: bold;
    font-size: 17px;
    background-color: transparent;
	border: none;
}

/* =================================================================
   استایل جادویی و شکلاتی برای دکمه‌های درون ویجت کتاب الکترونیک
==================================================================== */

QWidget QPushButton {
    background: none;
    background-color: transparent;

    border: 1px solid transparent;

    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;

    padding: 6px;
}


/* Hover — روشن و نرم */
QWidget QPushButton:hover {
    background-color: rgba(210, 170, 110, 45);
    border: 1px solid rgba(230, 190, 130, 90);
}


/* Pressed */
QWidget QPushButton:pressed {
    background-color: rgba(190, 145, 85, 70);
    border: 1px solid rgba(220, 180, 120, 120);
}


/* Checked */
QWidget QPushButton:checked {
    background-color: rgba(200, 160, 100, 60);
    border: 1px solid rgba(240, 210, 150, 130);
}


/* Checked + Hover */
QWidget QPushButton:checked:hover {
    background-color: rgba(215, 175, 115, 75);
    border: 1px solid rgba(250, 220, 170, 160);
}</string>
